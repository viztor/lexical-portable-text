{
  "name": "lexical-portable-text",
  "version": "0.2.0",
  "description": "Convert Lexical editor state to and from Portable Text",
  "keywords": [
    "blocks",
    "converter",
    "lexical",
    "portable-text",
    "portabletext",
    "rich-text"
  ],
  "homepage": "https://github.com/viztor/lexical-portable-text#readme",
  "bugs": {
    "url": "https://github.com/viztor/lexical-portable-text/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viztor/lexical-portable-text.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:watch": "vp test watch",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "verify": "vp check && vp test && vp pack",
    "prepublishOnly": "vp run verify"
  },
  "dependencies": {
    "@portabletext/types": "^4.0.2"
  },
  "devDependencies": {
    "@lexical/code": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@types/node": "^26.5.1",
    "lexical": "0.52.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "lexical": ">=0.30.0 <1.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.2"
}
